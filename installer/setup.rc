#include <windows.h>
#include "version.h"
1 RT_MANIFEST "setup.manifest"
101 RCDATA "../build/DaGrim.exe"
102 RCDATA "maintenance.ps1"
1 VERSIONINFO
FILEVERSION DAGRIM_VERSION_TUPLE
PRODUCTVERSION DAGRIM_VERSION_TUPLE
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "DaGrim Setup\0"
   VALUE "FileVersion", DAGRIM_VERSION_STRING "\0"
   VALUE "ProductName", "DaGrim\0"
   VALUE "ProductVersion", DAGRIM_VERSION_STRING "\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
