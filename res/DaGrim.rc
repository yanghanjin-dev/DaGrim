#include <windows.h>
#include <commctrl.h>
#include "resource.h"
#include "version.h"

1 24 "DaGrim.manifest"

IDD_NEW DIALOGEX 0, 0, 200, 100
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "New Document"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Width", IDC_LBL_W, 12, 14, 40, 12
    EDITTEXT        IDC_WIDTH, 58, 12, 50, 14, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT           "Height", IDC_LBL_H, 12, 34, 40, 12
    EDITTEXT        IDC_HEIGHT, 58, 32, 50, 14, ES_NUMBER | ES_AUTOHSCROLL
    AUTOCHECKBOX    "White background", IDC_WHITEBG, 12, 54, 120, 12
    DEFPUSHBUTTON   "OK", IDOK, 86, 78, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 142, 78, 50, 14
END

IDD_BC DIALOGEX 0, 0, 220, 110
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Brightness / Contrast"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Brightness", IDC_LBL_B, 12, 10, 196, 12
    CONTROL         "", IDC_BRIGHT, "msctls_trackbar32", TBS_HORZ | WS_TABSTOP, 12, 24, 196, 18
    LTEXT           "Contrast", IDC_LBL_C, 12, 48, 196, 12
    CONTROL         "", IDC_CONTRAST, "msctls_trackbar32", TBS_HORZ | WS_TABSTOP, 12, 62, 196, 18
    DEFPUSHBUTTON   "OK", IDOK, 104, 88, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 160, 88, 50, 14
END

IDD_SAT DIALOGEX 0, 0, 220, 80
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Saturation"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Saturation", IDC_LBL_S, 12, 10, 196, 12
    CONTROL         "", IDC_SAT, "msctls_trackbar32", TBS_HORZ | WS_TABSTOP, 12, 24, 196, 18
    DEFPUSHBUTTON   "OK", IDOK, 104, 56, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 160, 56, 50, 14
END

IDD_RENAME DIALOGEX 0, 0, 200, 70
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Rename Layer"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Name", IDC_LBL_N, 12, 12, 40, 12
    EDITTEXT        IDC_NAME, 12, 26, 176, 14, ES_AUTOHSCROLL
    DEFPUSHBUTTON   "OK", IDOK, 86, 48, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 142, 48, 50, 14
END

IDD_SCALE DIALOGEX 0, 0, 200, 110
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Resize Layer"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Width", IDC_LBL_W, 12, 14, 40, 12
    EDITTEXT        IDC_WIDTH, 58, 12, 50, 14, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT           "Height", IDC_LBL_H, 12, 34, 40, 12
    EDITTEXT        IDC_HEIGHT, 58, 32, 50, 14, ES_NUMBER | ES_AUTOHSCROLL
    AUTOCHECKBOX    "Keep aspect ratio", IDC_KEEP_ASPECT, 12, 54, 140, 12
    DEFPUSHBUTTON   "OK", IDOK, 86, 88, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 142, 88, 50, 14
END

IDD_TEXT DIALOGEX 0, 0, 220, 90
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Text"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Text", IDC_LBL_T, 12, 12, 40, 12
    EDITTEXT        IDC_TEXT, 12, 26, 196, 14, ES_AUTOHSCROLL
    LTEXT           "Size", IDC_LBL_FS, 12, 48, 40, 12
    EDITTEXT        IDC_FONTSIZE, 58, 46, 50, 14, ES_NUMBER | ES_AUTOHSCROLL
    DEFPUSHBUTTON   "OK", IDOK, 104, 68, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 160, 68, 50, 14
END

IDD_ABOUT DIALOGEX 0, 0, 240, 90
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About DaGrim"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "DaGrim", IDC_ABOUT_TEXT, 12, 14, 216, 40
    DEFPUSHBUTTON   "OK", IDOK, 178, 68, 50, 14
END

1 VERSIONINFO
FILEVERSION DAGRIM_VERSION_TUPLE
PRODUCTVERSION DAGRIM_VERSION_TUPLE
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "DaGrim Image Editor\0"
            VALUE "FileVersion", DAGRIM_VERSION_STRING "\0"
            VALUE "InternalName", "DaGrim\0"
            VALUE "OriginalFilename", "DaGrim.exe\0"
            VALUE "ProductName", "DaGrim\0"
            VALUE "ProductVersion", DAGRIM_VERSION_STRING "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
